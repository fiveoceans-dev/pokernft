{
  "name": "pokernft-websocket-server",
  "version": "1.0.0",
  "description": "WebSocket server for PokerNFT multiplayer game",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc --noEmitOnError false",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "deploy": "git subtree push --prefix=packages/nextjs/server heroku main",
    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "redis": "^4.7.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "jest": "^29.0.0"
  },
  "engines": {
    "node": "18.x",
    "npm": ">=8.0.0"
  },
  "keywords": ["poker", "websocket", "multiplayer", "starknet"],
  "license": "MIT"
}